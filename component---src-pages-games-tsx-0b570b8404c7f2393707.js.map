import * as React from "react";
import { useState } from "react";
import type { HeadFC, PageProps } from "gatsby";
import Layout from "../common/layout";
import { Body } from "../common/commonStyles";
import styled from "@emotion/styled";
import { StaticImage } from "gatsby-plugin-image";
import {
  fightOutcomes,
  foodPrompts,
  locationPrompts,
  personalityTypePrompts,
  perspectivePrompts,
  Scenario,
  scenarios,
  weapons,
  winterPrompts,
} from "../common/prompt";

const GameSection = styled.div`
  @media (max-width: 600px) {
    padding: 0.75rem;
    flex-direction: column;
  }
  box-shadow: 0 2px 1px hsl(220, 7%, 83%);
  background-color: hsl(110, 5%, 99%);
  padding: 1.5rem;
  margin-bottom: 2rem;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 1.5rem;
`;

const GameTitle = styled.h2`
  font-weight: bold;
  font-size: 1.4rem;
  margin-bottom: 0.75rem;
  color: rgba(0, 0, 0, 0.75);
`;

const GameDescription = styled.p`
  font-size: 1rem;
  line-height: 1.5;
  margin-bottom: 1rem;
  color: rgba(0, 0, 0, 0.75);
`;

const DrawButton = styled.button`
  color: #95a7b0;
  border: 2px solid #95a7b0;
  border-radius: 5px;
  background-color: #fff;
  padding: 5px 15px;
  font-family: Cormorant;
  font-size: 1rem;
  cursor: pointer;

  &:hover {
    background-color: hsl(200, 15%, 97%);
  }
`;

const PromptResult = styled.div`
  margin-top: 1rem;
  padding: 1rem 1.25rem;
  border-left: 3px solid #95a7b0;
  font-size: 1.05rem;
  line-height: 1.6;
  color: rgba(0, 0, 0, 0.75);
`;

const PromptLine = styled.p`
  margin: 0.2rem 0;
`;

function pickRandom<T>(arr: T[]): T {
  return arr[Math.floor(Math.random() * arr.length)];
}

function pickTwoDifferent(arr: string[]): [string, string] {
  const first = Math.floor(Math.random() * arr.length);
  let second = Math.floor(Math.random() * arr.length);
  // if (second == first) second++;
  // if (second >= arr.length) second = 0;
  return [arr[first], second == first ? "bigger " + arr[first] : arr[second]];
}

type FightDraw = {
  scenario: Scenario;
  weaponA: string;
  weaponB: string | null;
};

// ── Page ────────────────────────────────────────────────────

const WritingGamesPage: React.FC<PageProps> = () => {
  return (
    <Layout
      page="Writing Games"
      title="Merlin May - Writing Games"
      SeoDescription="Writing prompt games to spark creativity. Draw a random prompt and let the story unfold."
      SeoKeywords={[
        "Merlin May",
        "writing games",
        "writing prompts",
        "creative writing",
        "fiction writing prompts",
        "fight scene generator",
        "winter solstice writing",
      ]}
      SeoImage="../images/merlin.png"
    >
      <Body>
        <WinterSolsticeGame />

        <FightGame />

        <MeetCuteGame />

        <FoodGame />

        <PerspectiveGame />
      </Body>
    </Layout>
  );
};

const WinterSolsticeGame: React.FC = () => {
  const [solsticePrompt, setSolsticePrompt] = useState<string | null>(null);
  const drawSolstice = () => {
    setSolsticePrompt(pickRandom(winterPrompts));
  };
  return (
    <GameSection>
      <StaticImage
        style={{
          borderRadius: "10px",
          boxShadow: "0 2px 1px hsl(220, 7%, 83%)",
          flex: "none",
        }}
        width={150}
        height={150}
        alt={"A Santa hat."}
        src={"../images/solstice.jpeg"}
      />
      <div>
        <GameTitle>Winter Solstice Writing Game</GameTitle>
        <GameDescription>
          Write a short story, a carol, or just description or vibe of what
          would the Winter Solstice (Christmas) holiday look like if the Santa
          figure was the creature drawn as your prompt. Bonus points if they do
          wear the Santa hat.
        </GameDescription>
        <DrawButton onClick={drawSolstice}>Generate prompt</DrawButton>
        {solsticePrompt && <PromptResult>{solsticePrompt}</PromptResult>}
      </div>
    </GameSection>
  );
};

const FoodGame: React.FC = () => {
  const [foodPrompt, setFoodPrompt] = useState<string | null>(null);
  const drawFood = () => {
    setFoodPrompt(pickRandom(foodPrompts));
  };
  return (
    <GameSection>
      <StaticImage
        style={{
          borderRadius: "10px",
          boxShadow: "0 2px 1px hsl(220, 7%, 83%)",
          flex: "none",
        }}
        width={150}
        height={150}
        alt={"A plate of meatball pasta"}
        src={"../images/food.jpeg"}
      />
      <div>
        <GameTitle>Food Writing Game</GameTitle>
        <GameDescription>
          Write a short description of somebody experiencing the following food
          for the first time. They have no experience of the food before and
          they come from a completely different culture to the origin of the
          food.
        </GameDescription>
        <DrawButton onClick={drawFood}>Generate prompt</DrawButton>
        {foodPrompt && <PromptResult>{foodPrompt}</PromptResult>}
      </div>
    </GameSection>
  );
};

const PerspectiveGame: React.FC = () => {
  const [perspectivePrompt, setPerspectivePrompt] = useState<string | null>(
    null,
  );
  const drawPerspective = () => {
    setPerspectivePrompt(pickRandom(perspectivePrompts));
  };
  return (
    <GameSection>
      <div>
        <GameTitle>Perspective Writing Game</GameTitle>
        <GameDescription>
          Think of a story you are familiar with, it can be a book, movie, TV
          show... Write of a summary of the events of that story from the
          limited perspective of a minor or background character. Keep it short,
          as if the character is telling the story to someone else. You can
          later make it into something longer. For example, Rosencrantz and
          Guildenstern are Dead is kind of a perspective of Hamlet from the
          point of view of the two characters. Another famous example would be a
          standup routine about Harry Potter from the perspective of a random
          Hogwarts student starting at the same time decrying the fact that some
          asshole bought all the sweets from the cart before they even got the
          chance to order some.
        </GameDescription>
        <DrawButton onClick={drawPerspective}>Give me an idea</DrawButton>
        {perspectivePrompt && <PromptResult>{perspectivePrompt}</PromptResult>}
      </div>
    </GameSection>
  );
};

const FightGame: React.FC = () => {
  const [fightDraw, setFightDraw] = useState<FightDraw | null>(null);
  const [winnerPrompt, setWinnerPrompt] = useState<string | null>(null);

  const drawWinner = () => {
    setWinnerPrompt(pickRandom(fightOutcomes));
  };

  const drawFight = () => {
    const scenario = pickRandom(scenarios);
    if (scenario.isDuel) {
      const weapon = pickRandom(weapons);
      setFightDraw({ scenario, weaponA: weapon, weaponB: null });
    } else {
      const [wA, wB] = pickTwoDifferent(weapons);
      setFightDraw({ scenario, weaponA: wA, weaponB: wB });
    }
  };
  return (
    <GameSection>
      <StaticImage
        style={{
          borderRadius: "10px",
          boxShadow: "0 2px 1px hsl(220, 7%, 83%)",
          flex: "none",
        }}
        width={150}
        height={150}
        alt={
          "Logo of the fight scene generator. It features a sword and a rubber chicken crossed in an X."
        }
        src={"../images/fight.jpeg"}
      />
      <div>
        <GameTitle>Fight Scene Writing Game</GameTitle>
        <GameDescription>
          Write a scene where two characters are in a fight. The prompt will
          give you some information for the reason of their fight. Their fight
          may be unbalanced, or one sided. Their weapons may be the same or
          differ. Consider if it would be appropriate for that weapon to be a
          weapon of convenience, or a hidden weapon.
        </GameDescription>
        <DrawButton onClick={drawFight}>Generate Prompt</DrawButton>
        {fightDraw && (
          <PromptResult>
            <PromptLine>
              <strong>{fightDraw.scenario.text}</strong>
            </PromptLine>
            {fightDraw.weaponB === null ? (
              <PromptLine>
                Both wield: <em>{fightDraw.weaponA}</em>
              </PromptLine>
            ) : (
              <>
                <PromptLine>
                  A wields: <em>{fightDraw.weaponA}</em>
                </PromptLine>
                <PromptLine>
                  B wields: <em>{fightDraw.weaponB}</em>
                </PromptLine>
              </>
            )}
            <DrawButton onClick={drawWinner}>Pick Result For Me</DrawButton>
            {winnerPrompt && <PromptResult>{winnerPrompt}</PromptResult>}
          </PromptResult>
        )}
      </div>
    </GameSection>
  );
};

const MeetCuteGame: React.FC = () => {
  const [locationDraw, setLocationDraw] = useState<string | null>(null);
  const [personalityOnePrompt, setPersonalityOnePrompt] = useState<
    string | null
  >(null);
  const [personalityTwoPrompt, setPersonalityTwoPrompt] = useState<
    string | null
  >(null);

  const drawPersonalities = () => {
    setPersonalityOnePrompt(pickRandom(personalityTypePrompts));
    setPersonalityTwoPrompt(pickRandom(personalityTypePrompts));
  };

  const drawLocation = () => {
    setLocationDraw(pickRandom(locationPrompts));
  };
  return (
    <GameSection>
      <StaticImage
        style={{
          borderRadius: "10px",
          boxShadow: "0 2px 1px hsl(220, 7%, 83%)",
          flex: "none",
        }}
        width={150}
        height={150}
        alt={
          "Logo of the meet cute scene generator. It features a stick figure catching another stick figure as they fall."
        }
        src={"../images/meetcute.jpeg"}
      />
      <div>
        <GameTitle>Meet Cute Scene Writing Game</GameTitle>
        <GameDescription>
          Write a scene where two characters meet for the first time and it
          leads to a romanticised meet that off page may lead to a relationship,
          i.e. the meet-cute part of the romantic comedy/romance.
        </GameDescription>
        <DrawButton onClick={drawLocation}>Generate Prompt</DrawButton>
        {locationDraw && (
          <PromptResult>
            <PromptLine>Scene setting: {locationDraw}</PromptLine>
            <DrawButton onClick={drawPersonalities}>
              Pick personalities for me
            </DrawButton>
            {personalityOnePrompt && personalityTwoPrompt && (
              <PromptResult>
                {personalityOnePrompt + " X " + personalityTwoPrompt}
              </PromptResult>
            )}
          </PromptResult>
        )}
      </div>
    </GameSection>
  );
};

export default WritingGamesPage;

export const Head: HeadFC = () => <title>Writing Games</title>;
